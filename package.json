{
  "name": "x-market-backend",
  "version": "1.0.0",
  "description": "x-market-backend with node express and javascript",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start:dev": "cross-env NODE_ENV=development nodemon -r dotenv/config --experimental-json-modules src/server.js",
    "start:staging": "cross-env NODE_ENV=staging nodemon -r dotenv/config --experimental-json-modules src/server.js",
    "start:prod": "cross-env NODE_ENV=production nodemon -r dotenv/config --experimental-json-modules src/server.js"
  },
  "keywords": [
    "node",
    "expoess",
    "javascript"
  ],
  "author": "Dev Faldu",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.4",
    "mongoose-aggregate-paginate-v2": "^1.1.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.2"
  }
}
